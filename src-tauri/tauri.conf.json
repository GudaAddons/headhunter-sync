{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HeadHunter Sync",
  "version": "../package.json",
  "identifier": "com.headhunter.sync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HeadHunter Sync",
        "width": 560,
        "height": 720,
        "minWidth": 480,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCQ0JDNkEzMDg2NUIyQ0EKUldUS3NtVUlvOGJMTzlGSWFNUFJQVGdRVWN4RFE1NXpZSHg3NjNJRVNQSnhsMmxmKzNhdHkwR2EK",
      "endpoints": [
        "https://github.com/GudaAddons/headhunter-sync/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "msi"],
    "shortDescription": "Uploads your HeadHunter addon data to the HeadHunter bounty board",
    "longDescription": "HeadHunter Sync reads the HeadHunter addon's saved data (WTF\\Account\\<account>\\SavedVariables\\HeadHunter.lua) and sends your deaths, catches, duels and bounty to the HeadHunter website.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
